# --- Google Sheets ---
# 신청 데이터가 저장될 시트의 ID (시트 URL의 /d/[여기]/edit 부분)
GOOGLE_SHEETS_ID=

# GCP 서비스 계정 이메일 (예: ai-form@my-project.iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# 서비스 계정의 private_key.
# - 옵션 A) JSON 파일을 통째로 base64 인코딩한 문자열을 넣어도 됨 (개행 이슈 회피, 권장)
# - 옵션 B) 또는 private_key 문자열만 직접 넣어도 됨 ("\n"이 포함되어 있어야 함)
GOOGLE_SERVICE_ACCOUNT_KEY=

# 시트 안의 탭 이름 (기본값 responses, 비워두면 responses 자동 생성)
SHEET_TAB_NAME=responses
